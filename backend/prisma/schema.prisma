generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model admins {
  id            Int      @id @default(autoincrement())
  nama_lengkap  String
  username      String   @unique
  password_hash String   @db.VarChar(255)
  created_at    DateTime @default(now())
}

model Mahasiswa {
  nim               String    @id @unique
  nama              String
  password          String    @db.VarChar(255)
  angkatan          Int
  bu                String?
  dept              String?
  jenisKelamin      String?
  scholar           String?
  english           String?
  judulKp           String?
  judulTa           String?
  pakaiKacamata     Boolean?
  riwayatPenyakit   String?
  isProfileComplete Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  mentor            String?
  co_mentor         String?
  fileLaporanKp     String?
  fileLaporanTa     String?

  // --- [TAMBAHAN BARU: DETAIL NILAI KP] ---
  nilaiKpMentor     Float?    // Float agar bisa desimal (contoh: 85.5)
  nilaiKpPenguji    Float?
  nilaiKpAkhir      Float?
  komenKp           String?

  // --- [TAMBAHAN BARU: DETAIL NILAI TA] ---
  nilaiTaMentor     Float?
  nilaiTaPenguji    Float?
  nilaiTaAkhir      Float?
  komenTa           String?

  // Relasi ke tabel Tugas Mingguan
  daftarTugas       Tugas[]
}

model Tugas {
  id              Int       @id @default(autoincrement())
  taskNumber      String    
  judulTugas      String
  
  nilai           Int?      // Nilai tugas mingguan
  fileLaporan     String    
  filePresentasi  String?   
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  nim_mahasiswa   String
  mahasiswa       Mahasiswa @relation(fields: [nim_mahasiswa], references: [nim], onDelete: Cascade)

  @@unique([nim_mahasiswa, taskNumber])
}